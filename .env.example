# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (numeric, e.g. 123456789)
# Text /start to @userinfobot to get your ID
AUTHORIZED_USER_IDS=0

# Google Gemini API Key for Vision AI Extraction (Free from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Daily check time in 24h format (e.g. 08:00)
DAILY_CHECK_TIME=08:00
