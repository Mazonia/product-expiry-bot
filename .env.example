# =====================================================================
# Instant Bill & Expiry Date Alert Bot Configuration
# =====================================================================

# 1. Telegram Bot Token from @BotFather (Required)
# Open Telegram -> @BotFather -> /newbot -> Copy API Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Authorized Telegram User IDs (Required for Alert Delivery)
# Text /start to @userinfobot to get your numeric ID (e.g. 987654321)
AUTHORIZED_USER_IDS=0

# 3. Google Gemini API Key for Vision AI Extraction (Required)
# Free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Daily Scheduled Check Time in 24h format (e.g. 09:00 for 9:00 AM)
DAILY_CHECK_TIME=09:00
